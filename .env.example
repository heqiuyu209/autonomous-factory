# Autonomous Software Factory - environment template
# Copy to .env (or export in the shell) and adjust. Every value is optional;
# the defaults below match what the factory uses when unset.

# --- database -----------------------------------------------------------
# SQLite by default (zero-setup). For production point at PostgreSQL:
#   FACTORY_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/factory
FACTORY_DATABASE_URL=sqlite:///./factory.db

# --- runtime workspace --------------------------------------------------
# Where the factory keeps project worktrees and run artifacts.
FACTORY_WORKSPACE=./factory_runtime

# --- agent runtime ------------------------------------------------------
# Max repair attempts per task before the task is hard-blocked.
FACTORY_MAX_RETRIES=3
# Per-task ceilings.
FACTORY_TOKEN_BUDGET=120000
FACTORY_RUNTIME_BUDGET_S=1800

# --- verification pipeline ----------------------------------------------
# Comma-separated gates, run in order: syntax,test,lint,typecheck
#   lint / typecheck are auto-skipped when the tool is not installed.
FACTORY_VERIFY_GATES=syntax,test,lint

# --- optional real-LLM coding backend -----------------------------------
# When OPENAI_API_KEY is present, the coder uses the OpenAI-compatible
# backend instead of the deterministic in-process RecipeBackend.
# Secrets belong in the environment only - never commit real keys.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
